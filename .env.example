APP_NAME="Digital Theater Posters"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The URL Herd serves the app on (e.g. after `herd link`), used for generated links.
APP_URL=http://digital-theater-posters.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL as provided by Laravel Herd (Pro) or a standalone MySQL 8 install.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digital_theater_posters
DB_USERNAME=root
DB_PASSWORD=

# Keep it lightweight: no Redis, no queue worker needed.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log

#--------------------------------------------------------------------------
# Digital Theater Posters (config/posters.php)
#--------------------------------------------------------------------------

# Comma separated source keys to sync from (blocks in config/posters.php "sources").
POSTER_SOURCES=emby

# Bearer token for the control API (dim/black/playback/sync). Generate with:
#   php artisan posters:token          (prints the line)
#   php artisan posters:token --write  (writes it here)
# Empty = control endpoints disabled (503). Also accepted as ?token=... in the URL.
POSTER_API_TOKEN=

# --- Emby ---------------------------------------------------------------
EMBY_NAME=Emby
# Base URL of the Emby server, no trailing slash.
EMBY_URL=http://127.0.0.1:8096
# Emby Dashboard -> Advanced -> API Keys -> New API Key.
EMBY_API_KEY=
# Optional: only show what this Emby user can see (respects parental controls).
EMBY_USER_ID=
# Optional: comma separated library (parent) IDs. Empty = all libraries.
EMBY_LIBRARY_IDS=
# Emby item types to include (comma separated). v1 is movies only.
EMBY_ITEM_TYPES=Movie
# Items per API page while syncing.
EMBY_PAGE_SIZE=200
# HTTP timeout in seconds for Emby requests.
EMBY_TIMEOUT=20

# --- Sync + image cache ------------------------------------------------------
# Cron expression for the scheduled sync (needs `php artisan schedule:run` every minute).
POSTER_SYNC_CRON="15 */6 * * *"
# Deactivate posters missing from the source for this many consecutive full syncs.
POSTER_DEACTIVATE_AFTER=2
# Filesystem disk for cached images (see config/filesystems.php).
POSTER_IMAGE_DISK=posters
# Requested poster height in pixels (2160 suits a 4K portrait screen).
POSTER_IMAGE_MAX_HEIGHT=2160
# JPEG quality requested from the source (1-100).
POSTER_IMAGE_QUALITY=90

# --- Filters -------------------------------------------------------------------
# Comma separated official ratings never to show, e.g. "R,NC-17,NR". Empty = show all.
POSTER_EXCLUDE_RATINGS=

# --- Display ---------------------------------------------------------------------
# Seconds each poster stays on screen.
POSTER_ROTATE_SECONDS=30
# crossfade | fade (through black) | cut
POSTER_TRANSITION=crossfade
# Transition length in milliseconds.
POSTER_TRANSITION_MS=1500
# How often the display polls /api/display/state (ms). Lower = faster reaction to Home Assistant.
POSTER_STATE_POLL_MS=1000
# contain (whole poster, letterboxed) | cover (fill the screen, may crop)
POSTER_FIT=contain
# Background / letterbox colour.
POSTER_BACKGROUND="#000000"
# Show the title (year, rating, runtime) at the bottom of the screen.
POSTER_SHOW_TITLE=false

# --- Dimming (Home Assistant) -----------------------------------------------------
# Brightness (0-100) used for "dim" when no brightness is given.
POSTER_DIM_BRIGHTNESS=10
# Default fade duration for state changes (ms).
POSTER_FADE_MS=2000
# What POST /api/display/playback does per event: normal | dim | black ("resume" = play).
POSTER_ON_PLAY=black
POSTER_ON_PAUSE=dim
POSTER_ON_STOP=normal
# Safety net: return to normal after N minutes if nothing resets it (0 = never).
POSTER_AUTO_RESTORE_MINUTES=240
